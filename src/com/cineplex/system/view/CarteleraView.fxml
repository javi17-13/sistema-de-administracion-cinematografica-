<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="1000.0" stylesheets="@styles/AdminStyles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cineplex.system.controller.CarteleraController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="56.0" spacing="12.0" styleClass="header">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <children>
                <Label styleClass="header-titulo" text="CARTELERA" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtBuscar" prefWidth="220.0" promptText="Buscar por título o director" styleClass="campo" />
                <Button mnemonicParsing="false" onMouseClicked="#onNuevaPelicula" styleClass="boton-principal" text="Nueva película" />
                <Button mnemonicParsing="false" onMouseClicked="#onVolver" styleClass="boton-secundario" text="Volver" />
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="10.0" styleClass="panel" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="18.0" left="20.0" right="10.0" top="18.0" />
            </padding>
            <children>
                <Label styleClass="texto-tenue" text="Selecciona una película para ver su detalle completo." />
                <TableView fx:id="tablaPeliculas" prefHeight="460.0" styleClass="tabla" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTitulo" prefWidth="230.0" text="TÍTULO" />
                        <TableColumn fx:id="colGenero" prefWidth="130.0" text="GÉNERO" />
                        <TableColumn fx:id="colDuracion" prefWidth="90.0" text="DURACIÓN" />
                        <TableColumn fx:id="colCategoria" prefWidth="90.0" text="CATEGORÍA" />
                        <TableColumn fx:id="colDirector" prefWidth="160.0" text="DIRECTOR" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
    <right>
        <VBox prefWidth="290.0" spacing="10.0" styleClass="panel-lateral" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
            </padding>
            <children>
                <Label styleClass="seccion-titulo" text="DETALLE" />
                <Label fx:id="lblSinSeleccion" styleClass="texto-tenue" text="Ninguna película seleccionada." wrapText="true" />

                <ImageView fx:id="imgPoster" fitHeight="230.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true" />
                <Label fx:id="lblTitulo" styleClass="seccion-titulo" wrapText="true" />
                <Label fx:id="lblGenero" styleClass="dato-detalle" wrapText="true" />
                <Label fx:id="lblDuracion" styleClass="dato-detalle" />
                <Label fx:id="lblCategoria" styleClass="dato-detalle" />
                <Label fx:id="lblDirector" styleClass="dato-detalle" wrapText="true" />

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnEditar" maxWidth="Infinity" mnemonicParsing="false" onMouseClicked="#onEditar" styleClass="boton-secundario" text="Editar" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnEliminar" maxWidth="Infinity" mnemonicParsing="false" onMouseClicked="#onEliminar" styleClass="boton-peligro" text="Eliminar" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </right>
</BorderPane>
