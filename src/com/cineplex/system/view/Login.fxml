<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cineplex.system.controller.LoginController">
   <children>
      <HBox prefHeight="500.0" prefWidth="800.0">
         <children>
            <AnchorPane prefHeight="500.0" prefWidth="400.0">
               <children>
                  <ImageView fitHeight="500.0" fitWidth="400.0" pickOnBounds="true">
                     <image>
                        <Image url="@../resources/images/Inicio%20de%20sesion.png" />
                     </image>
                  </ImageView>
               </children>
            </AnchorPane>
            <AnchorPane fx:id="paneLogin" prefHeight="500.0" prefWidth="400.0" styleClass="login-panel">
               <children>
                  <VBox prefHeight="380.0" prefWidth="320.0" spacing="15.0" styleClass="login-card" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="60.0">
                     <children>
                        <Label styleClass="cineplex-title" text="CINEPLEX" textAlignment="CENTER">
                           <font>
                              <Font name="System Bold" size="32.0" />
                           </font>
                        </Label>
                        <Label styleClass="subtitle" text="Sistema de Administración Cinematográfica">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <Label styleClass="login-title" text="Inicio de sesión">
                           <font>
                              <Font size="22.0" />
                           </font>
                        </Label>
