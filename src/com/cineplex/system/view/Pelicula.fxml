<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="900.0" prefHeight="600.0" prefWidth="900.0" styleClass="pelicula-pane" stylesheets="@styles/PeliculaStyles.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cineplex.system.controller.PeliculaController">
   <children>
      <Label layoutX="38.0" layoutY="27.0" prefHeight="17.0" prefWidth="305.0" styleClass="titulo-pelicula" stylesheets="@styles/PeliculaStyles.css" text="Gestión de Películas" />
      <Label layoutX="33.0" layoutY="53.0" text="Título:" />
