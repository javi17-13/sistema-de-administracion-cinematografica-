      <Label layoutX="29.0" layoutY="163.0" text="Categoría:" />
      <Label layoutX="32.0" layoutY="214.0" prefHeight="17.0" prefWidth="47.0" text="Director" />
      <TextField fx:id="txtDirector" layoutX="23.0" layoutY="237.0" />
