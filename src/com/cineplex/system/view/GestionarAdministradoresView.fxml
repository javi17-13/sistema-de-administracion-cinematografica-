<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="1000.0" stylesheets="@styles/AdminStyles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cineplex.system.controller.GestionarAdministradoresController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="56.0" spacing="12.0" styleClass="header">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <children>
                <Label styleClass="header-titulo" text="GESTIONAR ADMINISTRADORES" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onMouseClicked="#onRefrescar" styleClass="boton-secundario" text="Refrescar" />
                <Button mnemonicParsing="false" onMouseClicked="#onVolver" styleClass="boton-secundario" text="Volver" />
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="10.0" styleClass="panel" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="18.0" left="20.0" right="10.0" top="18.0" />
            </padding>
            <children>
                <Label styleClass="texto-tenue" text="Selecciona una cuenta para editarla o darla de baja." />
                <TableView fx:id="tablaUsuarios" prefHeight="470.0" styleClass="tabla" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="230.0" text="NOMBRE" />
                        <TableColumn fx:id="colUsuario" prefWidth="180.0" text="USUARIO" />
                        <TableColumn fx:id="colRol" prefWidth="140.0" text="ROL" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
    <right>
        <VBox prefWidth="330.0" spacing="12.0" styleClass="panel-lateral" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
            </padding>
            <children>
                <Label fx:id="lblTituloFormulario" styleClass="seccion-titulo" text="NUEVA CUENTA" />

                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="etiqueta" text="NOMBRE COMPLETO" />
                        <TextField fx:id="txtNombre" promptText="Nombre del administrador" styleClass="campo" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="etiqueta" text="USUARIO" />
                        <TextField fx:id="txtUsuario" promptText="Nombre de usuario" styleClass="campo" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="etiqueta" text="CONTRASEÑA" />
                        <PasswordField fx:id="pwdClave" styleClass="campo" />
                        <Label fx:id="lblAyudaClave" styleClass="texto-tenue" text="Al editar, déjala vacía para no cambiarla." wrapText="true" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="etiqueta" text="ROL" />
                        <ComboBox fx:id="cmbRol" maxWidth="Infinity" styleClass="combo" />
                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardar" maxWidth="Infinity" mnemonicParsing="false" onMouseClicked="#onGuardar" styleClass="boton-principal" text="Crear cuenta" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onMouseClicked="#onCancelarEdicion" styleClass="boton-secundario" text="Limpiar" />
                    </children>
                </HBox>
                <Button fx:id="btnDarDeBaja" maxWidth="Infinity" mnemonicParsing="false" onMouseClicked="#onDarDeBaja" styleClass="boton-peligro" text="Dar de baja la cuenta seleccionada" />
            </children>
        </VBox>
    </right>
</BorderPane>
